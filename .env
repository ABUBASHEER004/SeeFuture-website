# EmailJS values are intentionally left empty until a valid EmailJS service is configured.
# The public key is safe to expose in a Vite frontend; never place private secrets here.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Set this to the final production domain before deployment if you use a custom domain.
VITE_SITE_URL=https://see-future-website.vercel.app
